DATABASE_URL="postgresql://tmpro:tmpro@localhost:5432/tmpro"
JWT_SECRET="dev-only-change-me"
PORT=3001

# Email notifications (leave requests/decisions, announcements, employee detail
# changes). Any SMTP-speaking provider works here (Resend, SendGrid, Postmark,
# Mailgun, SES, etc. all offer an SMTP relay) — just point these at it. Leave
# SMTP_HOST unset to use the built-in dev-mode transport, which logs emails to
# the console instead of sending them, so the feature works out of the box with
# no provider configured.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASS="changeme"
# SMTP_FROM="tmPro <notifications@example.com>"
